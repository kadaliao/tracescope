{
  "name": "tracescope",
  "version": "1.0.0",
  "description": "Real-time local network connections visualized on an interactive 3D globe",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "start": "node server/index.mjs",
    "test": "node --test server/**/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "keywords": [
    "traceroute",
    "network-visualization",
    "threejs",
    "mihomo",
    "websocket"
  ],
  "author": "Kada Liao",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadaliao/tracescope.git"
  },
  "homepage": "https://github.com/kadaliao/tracescope#readme",
  "bugs": {
    "url": "https://github.com/kadaliao/tracescope/issues"
  },
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
